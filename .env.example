# ---- API (artifacts/api-server) ----
DATABASE_URL=postgres://familia:familia@localhost:55432/familia_segura
PORT=5000
NODE_ENV=development
# Clerk (painel Clerk > API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# RevenueCat (Project settings > API keys > Secret API key v2, leitura de customers)
REVENUECAT_PROJECT_ID=proj7bc94c48
REVENUECAT_SECRET_API_KEY=sk_xxx
REVENUECAT_PREMIUM_ENTITLEMENT=premium
# Somente fora de produção: libera Premium para testes locais
PREMIUM_BYPASS=false
# Origens permitidas no CORS (separadas por vírgula). Vazio = só apps nativos.
CORS_ORIGINS=

# ---- App Expo (artifacts/familia-segura) ----
# URL completa da API. Em rede local use o IP do PC, ex.: http://192.168.0.10:5000
EXPO_PUBLIC_API_URL=http://192.168.0.10:5000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_xxx
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxx

# Dados do controlador (Política de Privacidade)
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_CNPJ=
LEGAL_DPO_EMAIL=

# Sem telemetria do Clerk (a API também força isso ao iniciar)
CLERK_TELEMETRY_DISABLED=1
